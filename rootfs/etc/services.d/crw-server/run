#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

# crw-server API service. Runs as appuser with the runtime config written by
# cont-init.d/01-crw-config.sh. Env overrides (CRW_*) are inherited from the
# container environment and always win over the config file.

export HOME="/home/appuser"
export USER="appuser"
export LOGNAME="appuser"

# Point crw-server at the runtime config materialized at boot. When unset,
# crw-server falls back to config.local.toml in the working directory.
export CRW_CONFIG="${CRW_CONFIG:-/config/aio/crw-runtime.toml}"

exec /command/s6-setuidgid appuser /usr/local/bin/crw-server
